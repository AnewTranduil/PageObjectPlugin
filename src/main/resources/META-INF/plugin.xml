<idea-plugin>
    <id>com.github.artem.pageobjectplugin</id>
    <name>Page Object Plugin</name>
    <vendor>Artem</vendor>

    <description><![CDATA[
        Plugin to ease usage of page objects in automated tests.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <projectListeners>
        <listener class="com.github.artem.pageobjectplugin.listeners.SnapshotDiscoveryListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Page Mirror"
                    anchor="right"
                    factoryClass="com.github.artem.pageobjectplugin.PageMirrorToolWindowFactory"/>
        <externalAnnotator language=""
                           implementationClass="com.github.artem.pageobjectplugin.annotators.SelectorValidationAnnotator"/>
        <projectConfigurable instance="com.github.artem.pageobjectplugin.settings.PageMirrorConfigurable"
                             displayName="Page Mirror"
                             id="com.github.artem.pageobjectplugin.settings"
                             parentId="tools"/>
        <statusBarWidgetFactory implementation="com.github.artem.pageobjectplugin.widgets.PageMirrorStatusBarWidgetFactory"
                                id="PageMirrorStatus"/>
        <notificationGroup id="Page Mirror" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="PageMirror.LoadSnapshot"
                class="com.github.artem.pageobjectplugin.actions.LoadSnapshotAction"
                text="Load Snapshot Directory..."
                description="Load a Page Mirror snapshot directory">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="PageMirror.ToggleInspect"
                class="com.github.artem.pageobjectplugin.actions.ToggleInspectAction"
                text="Toggle Inspect Mode"
                description="Toggle element inspection in Page Mirror">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift I"/>
        </action>
        <action id="PageMirror.HighlightCurrentSelector"
                class="com.github.artem.pageobjectplugin.actions.HighlightCurrentSelectorAction"
                text="Highlight Current Selector"
                description="Highlight the current line's selector in Page Mirror">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift H"/>
        </action>
    </actions>
</idea-plugin>
