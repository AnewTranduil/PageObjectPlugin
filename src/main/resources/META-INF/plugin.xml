<idea-plugin>
    <id>com.github.artem.pageobjectplugin</id>
    <name>Page Object Plugin</name>
    <vendor>Artem</vendor>

    <description><![CDATA[
        Plugin to ease usage of page objects in automated tests.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Page Mirror"
                    anchor="right"
                    factoryClass="com.github.artem.pageobjectplugin.PageMirrorToolWindowFactory"/>
    </extensions>
</idea-plugin>
